# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，请勿提交。
#   cp .env.example .env
#
# docker compose 与 Spring Boot 都会读取这些变量。

# ---------- 服务 ----------
SERVER_PORT=8085

# ---------- 数据库 ----------
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/serverdb?serverTimezone=GMT%2B8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# ---------- Redis ----------
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ---------- Kafka ----------
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# ---------- JWT ----------
# 必填：至少 32 字节的随机字符串，留空会导致应用启动失败。
# 生成方式：openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------- 邮件（QQ 邮箱需使用 SMTP 授权码） ----------
SEND_MESSAGE_EMAIL=
SEND_MESSAGE_CODE=

# ---------- Druid 监控台 ----------
DRUID_CONSOLE_ENABLED=false
DRUID_USERNAME=admin
DRUID_PASSWORD=

# ---------- 文件上传目录 ----------
UPLOAD_DIR=/app